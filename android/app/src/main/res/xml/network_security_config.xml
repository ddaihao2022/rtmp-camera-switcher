<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 局域网内的服务器地址是明文 HTTP（/api/server-info 探测），仅放行明文，不做证书校验降级 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
