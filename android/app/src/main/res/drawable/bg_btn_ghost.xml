<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1F27" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FF242A33" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2B323D" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</selector>
